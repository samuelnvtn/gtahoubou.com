---
import Navigation from '../components/navbar.astro'
import Footer from '../components/footer.astro'
import obrazek from '../img/show.png';
import figurka from '../img/figurka.png'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="gta_logo_green.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
		<title>GTA Houbou</title>
	</head>
	<body>
		<Navigation></Navigation>
		<div class="content">
			<div class="poster">
						<a href="/hulicvlakyrkach_game.html" class="poster-link">
							<img src={figurka.src} class="nudge-animation">
						</a>
			</div>
		</div>
		<Footer></Footer>
	</body>
</html>

<style>
	 *{
        margin: 0;
        padding: 0;
		box-sizing: border-box;
    }

	body {
		overflow-x: hidden;
	}

	.anton-regular {
  font-family: "Anton", sans-serif;
  font-weight: 400;
  font-style: normal;
}
.video-container {
    width: 325px; 
    height: 700px; 
    overflow: hidden;
    border-radius: 12px;
    margin: 0 auto;
}

.video-container iframe {
    margin-top: -80px;
}

	h1 {
		font-weight: 400;
		font-size: 40px;
		color:#222a19 ;
		margin-bottom: 10px;
		font-family: "Anton", sans-serif;
	}

	h3 {
		font-weight: 400;
		font-size: 20px;
		color:#4F5845 ;
		margin-bottom: 10px;
		font-family: "Anton", sans-serif;
		
	}

	img {
		height: 600px;
		width: auto;
		margin-bottom: 10px;
	}

	.content {
		background-color: #111;
		min-height: 100vh; //91vh
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 40px 0;
	}

	.poster {
        display: flex;           
        flex-direction: column;  
        align-items: center;     
        text-align: center;
	}

	a {
		text-decoration: none;
	}

	.poster-link {
    display: inline-block;
    transition: transform 0.3s ease-out;
}

.poster-link:hover {
    transform: scale(1.05);
}

	.nudge-animation {
    transition: transform 0.2s ease-in-out;
    animation: occasional-wiggle 2.5s infinite;
  }

  .nudge-animation:hover {
    transform: scale(1.05);
    animation: none; 
  }

  @keyframes occasional-wiggle {
    0%, 85%, 100% { 
      transform: rotate(0deg) scale(1); 
    }
    88% { 
      transform: rotate(-3deg) scale(1.05); 
    }
    92% { 
      transform: rotate(3deg) scale(1.05); 
    }
    96% { 
      transform: rotate(-3deg) scale(1.05); 
    }
  }

</style>
